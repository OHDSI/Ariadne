# --- Database Configuration ---
VOCAB_CONNECTION_STRING=postgresql+psycopg://my_user:my_password@my_server.com/vocabulary
VOCAB_SCHEMA=public
VOCAB_VECTOR_TABLE=concept_vector

# --- GenAI Configuration ---
# Options: 'openai', 'azure', 'lm-studio'
GENAI_PROVIDER=azure
LLM_MODEL=o3
LLM_API_KEY=your_key_here
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_API_KEY=your_key_here

# LLM_API_KEY and EMBEDDING_API_KEY are not used when GENAI_PROVIDER is 'lm-studio'

# Required if GENAI_PROVIDER is 'azure'
AZURE_LLM_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_EMBEDDING_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Required if GENAI_PROVIDER is 'lm-studio'
LM_STUDIO_ENDPOINT=http://localhost:1234/v1

# --- SNOMED Classification (optional; only for the hierarchy classifier) ---
# Can also be passed explicitly to the classifier
SNOMED_OWL_TOOLKIT_JAR=/path/to/snomed-owl-toolkit.jar
SNOMED_BASE_RELEASE_ZIP=/path/to/SnomedCT_InternationalRF2_Snapshot.zip


# --- Decision model (TypeSafe System One, e.g. Jev; optional, used by DecisionModelMapper) ---
TYPESAFE_API_KEY=your_key_here
