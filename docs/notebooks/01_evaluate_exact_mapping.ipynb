    "    \"     \\\"start_time\\\": \\\"2026-05-05T07:07:47.288039900Z\\\"\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"   },\\n\",\n",
    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"from ariadne.evaluation.concept_search_evaluator import evaluate_concept_search\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
