    "    \"   \\\"id\\\": \\\"ab33a44e37137ed9\\\",\\n\",\n",
    "    \"   \\\"metadata\\\": {},\\n\",\n",
    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"This gold standard contains the following columns:\\\\n\\\",\\n\",\n",
    "    \"    \\\" - `source_code`: the concept ID of the source term (non-standard concept)\\\\n\\\",\\n\",\n",
    "    \"    \\\"  - `source_term`: the source term text\\\\n\\\",\\n\",\n",
    "    \"    \\\"  - `standard_concept_id`: the concept ID of the standard concept to which the source term maps\\\\n\\\",\\n\",\n",
    "    \"    \\\"  - `standard_concept_name`: the name of the standard concept\\\\n\\\",\\n\",\n",
    "    \"    \\\"  - `predicate`: Whether the mapping is an `exactMatch` or a `broadMatch`. Only `exactMatch` mappings are considered correct in this evaluation.\\\\n\\\",\\n\",\n",
    "    \"    \\\"  - `target_concept_id_b`, `target_concept_name_b`, and `predicate_b`: optional second mapping for the source term that is equally valid, if available.\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"## Term cleanup\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"The first step is to clean up the source terms, removing any extraneous information that may interfere with matching.\\\\n\\\",\\n\",\n",
    "    \"    \\\"This includes removing phrases like \\\\\\\"not otherwise specified\\\\\\\", as well as other uninformative parts of the source term.\\\\n\\\",\\n\",\n",
    "    \"    \\\"This step uses the LLM to perform the cleanup.\\\\n\\\",\\n\",\n",
    "    \"    \\\"The `TermCleaner` class handles this, using the system prompts specified in the `config_condition_mapping.yaml` file, and adds a `cleaned_term` column to the input DataFrame.\\\"\\n\",\n",
    "    \"   ]\\n\",\n",
    "    \"  },\\n\",\n",
    "    \"  {\\n\",\n",
    "    \"   \\\"cell_type\\\": \\\"code\\\",\\n\",\n",
    "    \"   \\\"id\\\": \\\"afaf33a5b130bc29\\\",\\n\",\n",
    "    \"   \\\"metadata\\\": {\\n\",\n",
    "    \"    \\\"ExecuteTime\\\": {\\n\",\n",
    "    \"     \\\"end_time\\\": \\\"2026-05-05T07:07:45.119556200Z\\\",\\n\",\n",
    "    \"     \\\"start_time\\\": \\\"2026-05-05T07:07:43.617469700Z\\\"\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"   },\\n\",\n",
    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"from ariadne.term_cleanup.term_cleaner import TermCleaner\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"cleaned_terms_file = project_root / \\\\\\\"data\\\\\\\" / \\\\\\\"notebook_results\\\\\\\" / \\\\\\\"exact_matching_cleaned_terms.csv\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"if cleaned_terms_file.exists():\\\\n\\\",\\n\",\n",
    "    \"    \\\"    cleaned_terms = pd.read_csv(cleaned_terms_file)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(\\\\\\\"Loaded cleaned terms from file.\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    term_cleaner = TermCleaner(config.term_cleaning)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    cleaned_terms = term_cleaner.clean_terms(gold_standard)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(f\\\\\\\"Total LLM cost: ${term_cleaner.get_total_cost():.6f}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"cleaned_terms.to_csv(cleaned_terms_file, index=False)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"cleaned_terms[[\\\\\\\"source_term\\\\\\\", \\\\\\\"cleaned_term\\\\\\\"]].head(10)\\\"\\n\",\n",
