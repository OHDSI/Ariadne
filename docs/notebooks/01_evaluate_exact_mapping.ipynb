    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"## Embedding vector search\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"Next, we perform embedding vector search for the source terms that were not matched by verbatim matching.\\\\n\\\",\\n\",\n",
    "    \"    \\\"This uses the vector store specified in the `config_condition_mapping.yaml` file, which can be either a local PGVector instance or the OHDSI Hecate API.\\\"\\n\",\n",
    "    \"   ]\\n\",\n",
    "    \"  },\\n\",\n",
    "    \"  {\\n\",\n",
    "    \"   \\\"cell_type\\\": \\\"code\\\",\\n\",\n",
