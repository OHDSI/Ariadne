    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"vector_search_results_file = project_root / \\\\\\\"data\\\\\\\" / \\\\\\\"notebook_results\\\\\\\" / \\\\\\\"exact_matching_vector_search_results.csv\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"if vector_search_results_file.exists():\\\\n\\\",\\n\",\n",
    "    \"    \\\"    vector_search_results = pd.read_csv(vector_search_results_file)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    print(\\\\\\\"Loaded vector search results from file.\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    evaluation_vector_settings = VectorSearchSettings(\\\\n\\\",\\n\",\n",
    "    \"    \\\"        max_candidates=config.vector_search.max_candidates,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        standard_concept=config.vector_search.standard_concept,\\\\n\\\",\\n\",\n",
