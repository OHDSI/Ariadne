    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"### Evaluating the vector search results\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"We can now evaluate the vector search results on their own, before combining them with the verbatim matches.\\\\n\\\",\\n\",\n",
    "    \"    \\\"The results are written to a text file that contains overall statistics as well as detailed per-term results.\\\"\\n\",\n",
    "    \"   ]\\n\",\n",
